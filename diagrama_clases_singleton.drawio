<mxCell id="ley_c1" value='&lt;table style="border-collapse:collapse;font-size:13px;color:#3B4A58"&gt;&lt;tr&gt;&lt;td style="padding:3px 12px 3px 0;font-weight:bold;font-family:Menlo;color:#2E8B57"&gt;+&lt;/td&gt;&lt;td style="padding:3px 0"&gt;&lt;b&gt;Público&lt;/b&gt;: sin guion bajo (self.nombre)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px 12px 3px 0;font-weight:bold;font-family:Menlo;color:#C0392B"&gt;-&lt;/td&gt;&lt;td style="padding:3px 0"&gt;&lt;b&gt;Privado&lt;/b&gt;: doble guion bajo (self.__saldo)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px 12px 3px 0;font-weight:bold;font-family:Menlo;color:#B7791F"&gt;#&lt;/td&gt;&lt;td style="padding:3px 0"&gt;&lt;b&gt;Protegido&lt;/b&gt;: un guion bajo (_contador)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px 12px 3px 0;font-weight:bold;color:#15304A"&gt;&lt;u&gt;abc&lt;/u&gt;&lt;/td&gt;&lt;td style="padding:3px 0"&gt;&lt;b&gt;Estático&lt;/b&gt;: subrayado, es de la clase&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="58" y="922" width="420" height="170" as="geometry"/></mxCell>
<mxCell id="ley_c2" value='&lt;table style="border-collapse:collapse;font-size:13px;color:#3B4A58"&gt;&lt;tr&gt;&lt;td style="padding:3px 12px 3px 0;font-weight:bold;color:#15304A;font-size:15px"&gt;▷&lt;/td&gt;&lt;td style="padding:3px 0"&gt;&lt;b&gt;Herencia&lt;/b&gt;: triángulo hueco hacia la clase padre&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px 12px 3px 0;font-weight:bold;color:#15304A;font-size:15px"&gt;⇢&lt;/td&gt;&lt;td style="padding:3px 0"&gt;&lt;b&gt;Dependencia&lt;/b&gt;: línea punteada, una clase usa a otra&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px 12px 3px 0;font-weight:bold;color:#15304A;font-size:15px"&gt;↺&lt;/td&gt;&lt;td style="padding:3px 0"&gt;&lt;b&gt;Auto-asociación&lt;/b&gt;: la clase guarda su propia instancia&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px 12px 3px 0;font-weight:bold;color:#15304A;font-size:15px"&gt;◆&lt;/td&gt;&lt;td style="padding:3px 0"&gt;&lt;b&gt;Composición&lt;/b&gt;: la parte no existe sin su dueño&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px 12px 3px 0;font-weight:bold;color:#15304A;font-size:15px"&gt;◇&lt;/td&gt;&lt;td style="padding:3px 0"&gt;&lt;b&gt;Agregación&lt;/b&gt;: la parte existe por su cuenta&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px 12px 3px 0;font-weight:bold;color:#15304A"&gt;0..*&lt;/td&gt;&lt;td style="padding:3px 0"&gt;&lt;b&gt;Multiplicidad&lt;/b&gt;: cero o muchos; 1 = exactamente uno&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="520" y="922" width="470" height="170" as="geometry"/></mxCell>
